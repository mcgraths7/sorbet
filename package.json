{
  "name": "sorbet",
  "version": "0.1.0",
  "private": true,
  "description": "Sorbet — a fun, themeable, accessibility-first design system. Sass + TypeScript core with React bindings per atomic layer.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "build:design-system": "pnpm --filter @sorbet/design-system build",
    "build:component-library": "pnpm --filter @sorbet/component-library build",
    "build:cli": "pnpm --filter @sorbet/cli build",
    "check:contrast": "pnpm --filter @sorbet/design-system check:contrast",
    "check:client": "pnpm --filter @sorbet/component-library check:client",
    "pack:vendor": "node tools/pack-vendor.ts",
    "check:consumable": "node tools/check-consumable.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "lint:styles": "pnpm --filter @sorbet/design-system lint:styles",
    "lint:styles:fix": "pnpm --filter @sorbet/design-system lint:styles:fix",
    "playground": "pnpm --filter playground dev",
    "example": "pnpm --filter meal-kit dev",
    "example:admin": "pnpm --filter admin dev",
    "test": "pnpm run check:contrast && pnpm run check:client",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass": "^1.83.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
